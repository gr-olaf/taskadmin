# Локальный запуск (NODE_ENV не задан или development): используется .env
# Продакшен (NODE_ENV=production): используется .env.production
# Альтернатива для продакшена: переменная DATABASE_URL (Render проставляет её автоматически)
PORT=8080
PGHOST=my-postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=root
PGDATABASE=taskadmin
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require